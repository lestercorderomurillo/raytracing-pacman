<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>0.4.0</Version>
    <RadiantRoot Condition="'$(RadiantRoot)' == ''">$(MSBuildProjectDirectory)/../radiant-game-engine</RadiantRoot>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Keep field/property documentation optional; validate all XML comments. -->
    <NoWarn>$(NoWarn);1591</NoWarn>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <Import Project="$(RadiantRoot)/eng/Radiant.Desktop.props" Condition="Exists('$(RadiantRoot)/eng/Radiant.Desktop.props')" />
  <ItemGroup>
    <Compile Include="Program.cs;src/**/*.cs" />
    <ProjectReference Include="$(RadiantRoot)/radiant.csproj" />
    <MonoGameContentReference Include="Content/Content.mgcb" />
    <Content Include="Content/fonts/*.ttf" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CheckRadiantCheckout" BeforeTargets="CollectPackageReferences;PrepareForBuild">
    <Error Condition="!Exists('$(RadiantRoot)/eng/Radiant.Desktop.props')" Text="Clone radiant-game-engine beside this repository, or set -p:RadiantRoot=/path/to/radiant-game-engine. See BUILD.md for the paired checkout instructions." />
  </Target>
</Project>
